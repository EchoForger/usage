#!/usr/bin/env python3
"""Update data.json and publish to GitHub Pages.

  usage -s 0.8            morning: sleep score, sets today's token budget
  usage -c 0.7 -d 0.4     any time: clarity (model size) and desire (effort)
  usage -l 0.6            any time: 60% of today's budget left now, decaying to 0 at midnight
  usage -c 0.5 --no-push  commit locally only
  usage -o                open the local site at http://localhost:8765
"""
import argparse
import json
import socket
import subprocess
import sys
import webbrowser
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import brain  # noqa: E402
from server import PORT  # noqa: E402


def unit(value):
    x = float(value)
    if not 0 <= x <= 1:
        raise argparse.ArgumentTypeError("must be between 0 and 1")
    return x


def open_local():
    # The launchd service normally keeps the server up; start one if it is not.
    with socket.socket() as s:
        running = s.connect_ex(("127.0.0.1", PORT)) == 0
    if not running:
        subprocess.Popen(
            [sys.executable, str(brain.ROOT / "server.py")],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
        )
    url = f"http://localhost:{PORT}/"
    webbrowser.open(url)
    print(f"Opened {url}")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-s", "--sleep", type=unit, help="sleep score, 0-1")
    p.add_argument("-c", "--clarity", type=unit, help="how awake right now, 0-1")
    p.add_argument("-d", "--desire", type=unit, help="desire to think deeply right now, 0-1")
    p.add_argument("-l", "--left", type=unit, help="share of today's budget left right now, 0-1")
    p.add_argument("--no-push", action="store_true", help="commit but do not push")
    p.add_argument("-o", "--open", action="store_true", help="open the local site in the browser")
    args = p.parse_args()
    changes = {k: v for k in brain.FIELDS if (v := getattr(args, k)) is not None}
    if not changes:
        if args.open:
            return open_local()
        p.error("give at least one of -s, -c, -d, -l, -o")

    print(json.dumps(brain.update(changes), indent=2))
    if args.open:
        open_local()
    if args.no_push:
        return
    brain.push()
    print("Pushed. GitHub Pages usually updates within a minute.")


if __name__ == "__main__":
    main()
